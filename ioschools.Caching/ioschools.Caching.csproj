<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ioschools.Caching</RootNamespace>
    <AssemblyName>ioschools.Caching</AssemblyName>
    <!-- Assembly metadata replaces legacy Properties/AssemblyInfo.cs -->
    <AssemblyTitle>ioschools.Caching</AssemblyTitle>
    <AssemblyDescription>In-memory caching abstraction for ioschools using IMemoryCache</AssemblyDescription>
    <Company></Company>
    <Product>ioschools.Caching</Product>
    <Copyright>Copyright © 2011</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- IMemoryCache - replaces System.Web.Caching.HttpRuntime.Cache -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
