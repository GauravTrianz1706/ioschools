@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4>Login to ioSchools</h4>
            </div>
            <div class="card-body">
                <div id="login-error" class="alert alert-danger d-none"></div>
                
                <form id="login-form">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <input type="email" class="form-control" id="email" name="email" required />
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" name="password" required />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="remember_me" name="remember_me" />
                        <label class="form-check-label" for="remember_me">Remember me</label>
                    </div>
                    <button type="submit" class="btn btn-primary">Login</button>
                    <a href="#" id="forgot-link" class="ms-3">Forgot password?</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Login form - replaces legacy AJAX login
        $('#login-form').on('submit', function(e) {
            e.preventDefault();
            $.post('/login', {
                email: $('#email').val(),
                password: $('#password').val(),
                remember_me: $('#remember_me').is(':checked'),
                redirect: '@Html.Raw(Context.Request.Query["redirect"])'
            }, function(data) {
                if (data.success) {
                    window.location.href = data.data || '/dashboard';
                } else {
                    $('#login-error').text(data.message).removeClass('d-none');
                }
            });
        });

        $('#forgot-link').on('click', function(e) {
            e.preventDefault();
            var email = prompt('Enter your email address:');
            if (email) {
                $.post('/login/forgot', { email: email }, function(data) {
                    if (data.success) {
                        alert(data.message);
                    } else {
                        alert(data.message);
                    }
                });
            }
        });
    </script>
}
