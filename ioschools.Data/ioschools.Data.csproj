<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ioschools.Data</RootNamespace>
    <AssemblyName>ioschools.Data</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- AssemblyInfo is auto-generated by SDK-style projects; no need for Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>ioSchools</Company>
    <Product>ioSchools Data</Product>
    <Copyright>Copyright © ioSchools 2024</Copyright>
    <Description>Shared enums, constants, and data transfer types for ioSchools application</Description>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Exclude legacy AssemblyInfo.cs - SDK-style projects auto-generate assembly attributes -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
